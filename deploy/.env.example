# The address of the hosted app (DNS A record → this server), without https://
DOMAIN=app.example.com

# CouchDB admin (make up a long password). Used by the app to create accounts,
# record payments and create each church's cloud databases.
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=

# PayMongo (leave empty until you have keys: paying is then simply off)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# PAYMONGO_METHODS=gcash,card

# Optional: AI chat
GEMINI_API_KEY=
